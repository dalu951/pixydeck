# EMEET PIXY (USB 328f:00c0): allow the active desktop user to access HID controls.
ACTION!="remove", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="328f", ATTRS{idProduct}=="00c0", MODE="0660", TAG+="uaccess"
# PixyDeck virtual camera (v4l2loopback): let the active desktop user feed it
# without joining the broad 'video' group.
ACTION!="remove", SUBSYSTEM=="video4linux", ATTR{name}=="PixyDeck Virtual Camera", TAG+="uaccess"
