#!/usr/bin/env bash
set -euo pipefail

NAME="EMEET PIXY (PixyDeck)"
LEGACY_NAME="PixyDeck Virtual Camera"  # before 0.5.0
# Lowest free number: at boot that is /dev/video0, ahead of the real camera.
START=0
END=29
# Overridable only for the test suite; systemd and pkexec run this with a clean environment.
SYSFS="${PIXYDECK_SYSFS:-/sys}"
DEV="${PIXYDECK_DEV:-/dev}"
CTL="${PIXYDECK_LOOPBACK_CTL:-/usr/bin/v4l2loopback-ctl}"

find_device() {
    local wanted="${1:-$NAME}" path base name
    shopt -s nullglob
    for path in "$SYSFS"/class/video4linux/video*/name; do
        name=$(cat "$path" 2>/dev/null || true)
        if [[ "$name" == "$wanted" ]]; then
            base=$(basename "$(dirname "$path")")
            printf '%s/%s\n' "$DEV" "$base"
            return 0
        fi
    done
    return 1
}

start_device() {
    local existing n dev
    if existing=$(find_device); then
        echo "$existing"
        return 0
    fi
    # Rename a device left by an older version; keep it while an app uses it.
    if existing=$(find_device "$LEGACY_NAME"); then
        if ! "$CTL" delete "$existing" 2>/dev/null; then
            echo "$existing"
            return 0
        fi
    fi

    for n in $(seq "$START" "$END"); do
        dev="$DEV/video${n}"
        if [[ ! -e "$dev" ]]; then
            "$CTL" add -n "$NAME" -x 1 "$dev"
            return 0
        fi
    done

    echo "No free video device found in /dev/video${START}..${END}" >&2
    return 1
}

stop_device() {
    local existing wanted
    for wanted in "$NAME" "$LEGACY_NAME"; do
        if existing=$(find_device "$wanted"); then
            # A device an app still reads cannot be removed; leave it for now.
            "$CTL" delete "$existing" || echo "$existing is in use, kept" >&2
        fi
    done
}

case "${1:-}" in
    start) start_device ;;
    stop)  stop_device ;;
    status)
        if find_device || find_device "$LEGACY_NAME"; then exit 0; else exit 1; fi
        ;;
    *)
        echo "Usage: $0 start|stop|status" >&2
        exit 2
        ;;
esac
