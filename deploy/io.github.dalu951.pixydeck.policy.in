<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>EMEET PixyDeck</vendor>
  <vendor_url>https://github.com/dalu951/pixydeck</vendor_url>
  <icon_name>pixydeck</icon_name>
  <action id="io.github.dalu951.pixydeck.setup">
    <description>Set up the EMEET PIXY camera integration</description>
    <description xml:lang="de">EMEET-PIXY-Kameraintegration einrichten</description>
    <message>Authentication is required to set up the PixyDeck virtual camera and camera permissions (this can include adding you to the 'video' group).</message>
    <message xml:lang="de">Zum Einrichten der virtuellen PixyDeck-Kamera und der Kamera-Berechtigungen ist eine Authentifizierung erforderlich (ggf. wird Ihr Konto zur Gruppe „video“ hinzugefügt).</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@HELPER@</annotate>
  </action>
</policyconfig>
